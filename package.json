{
  "name": "world-line",
  "private": true,
  "version": "1.6.3",
  "license": "MIT",
  "type": "module",
  "description": "World Line: an animated, spoiler-safe explainer of the Steins;Gate and Steins;Gate 0 story and time-travel mechanics.",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:canon",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:canon": "tsx scripts/validate-canon.ts data/canon.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "framer-motion": "^14.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
